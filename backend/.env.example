# Backend Environment Variables
# Copy your values from the main .env file

# Blockchain RPC URL (copy from VITE_RPC_URL in .env)
VITE_RPC_URL=

# Certificates Contract Address (copy from VITE_CERTIFICATES_CONTRACT_ADDRESS in .env)
VITE_CERTIFICATES_CONTRACT_ADDRESS=

# Server Port (optional, defaults to 3001)
PORT=3001
